# Copy to .env and fill in values
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
ALLOW_DEV_AUTH=false
DEBUG=false
CORS_ORIGINS=*

# Optional campaign window (ISO 8601, UTC)
# CAMPAIGN_START=2026-07-01T00:00:00+00:00
# CAMPAIGN_END=2026-08-01T00:00:00+00:00

# Local Docker Compose
DATABASE_URL=postgresql+asyncpg://wheel:wheel@postgres:5432/discount_wheel
REDIS_URL=redis://redis:6379/0

# Railway: add PostgreSQL plugin — DATABASE_URL is injected automatically.
# Railway: optional Redis plugin — REDIS_URL is injected automatically.
# Railway frontend service:
# BACKEND_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
